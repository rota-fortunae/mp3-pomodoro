; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="mp3_pomodoro"
run/main_scene="uid://csv8w68ys6y8b"
config/disable_project_settings_override=true
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://dvbcar24urv2l"

[display]

window/size/viewport_width=384
window/size/viewport_height=160
window/size/borderless=true
window/size/transparent=true
window/size/window_width_override=1536
window/size/window_height_override=640
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
viewport/transparent_background=true

